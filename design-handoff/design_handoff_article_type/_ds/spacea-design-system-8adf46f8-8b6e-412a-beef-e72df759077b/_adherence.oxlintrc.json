{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/article/**",
              "components/layout/**",
              "components/ui/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Sans TC))/i]",
        "message": "Font not provided by the design system. Available: Noto Sans TC."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleBody'] > JSXAttribute > JSXIdentifier[name!=/^(?:content|children|key|ref|className|style|children)$/]",
        "message": "<ArticleBody> doesn't accept that prop. Declared props: content, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCardCategory'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|href|key|ref|className|style|children)$/]",
        "message": "<ArticleCardCategory> doesn't accept that prop. Declared props: name, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:posts|columns|emptyLabel|onNavigate|key|ref|className|style|children)$/]",
        "message": "<ArticleGrid> doesn't accept that prop. Declared props: posts, columns, emptyLabel, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleMetaTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|slug|key|ref|className|style|children)$/]",
        "message": "<ArticleMetaTag> doesn't accept that prop. Declared props: name, slug."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: label, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BreadcrumbItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<BreadcrumbItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|accent)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outline' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:categories|title|columns|onNavigate|key|ref|className|style|children)$/]",
        "message": "<CategoryGrid> doesn't accept that prop. Declared props: categories, title, columns, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|count|image|href|onNavigate|key|ref|className|style|children)$/]",
        "message": "<CategoryTile> doesn't accept that prop. Declared props: name, count, image, href, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:siteName|description|items|year|onNavigate|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: siteName, description, items, year, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:siteName|onNavigate|onSearch|sticky|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: siteName, onNavigate, onSearch, sticky."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: src, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:hasNextPage|onLoadMore|loading|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: hasNextPage, onLoadMore, loading."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:onSearch|placeholder|key|ref|className|style|children)$/]",
        "message": "<SearchBar> doesn't accept that prop. Declared props: onSearch, placeholder."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
