# WordPress (Headless CMS)
NEXT_PUBLIC_WORDPRESS_URL=https://your-wordpress-domain.com

# 本站公開網址（Zeabur 部署後填入）
NEXT_PUBLIC_SITE_URL=https://your-spacea-domain.com

# Google Analytics 4 Measurement ID（選用）
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ISR On-demand Revalidation Secret（自行產生隨機字串）
REVALIDATE_SECRET=your-secret-token-here

# IndexNow 金鑰（8～128 碼英數，自行產生；/api/revalidate 清快取時會順手通知 Bing 等引擎）
# 驗證檔由 /indexnow-key.txt 吐出，不用另外放檔案。留空就不通知
INDEXNOW_KEY=

# 聯絡表單（/api/contact）轉發到 n8n workflow「spaceA-聯絡表單通知」，
# 該 workflow 會把表單內容發到 Slack #機器人測試。留空則用程式碼裡寫死的預設網址。
# N8N_CONTACT_WEBHOOK_URL=https://stack.zeabur.app/webhook/spacea-contact
NEXT_PUBLIC_JOIN_FORM_URL=https://forms.gle/xxxx   # 加入寫手團隊的 Google 表單
